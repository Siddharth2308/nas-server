# Server
PORT=8082

# Tailscale-issued TLS cert (renewed monthly via cron: tailscale cert ubuntu-server.tailf009e6.ts.net)
SSL_CERT=/etc/caddy/ubuntu-server.tailf009e6.ts.net.crt
SSL_KEY=/etc/caddy/ubuntu-server.tailf009e6.ts.net.key

# Tailscale
# Generate an API access token at: https://login.tailscale.com/admin/settings/keys
TAILSCALE_API_KEY=tskey-api-XXXXX
TAILSCALE_TAILNET=tailf009e6.ts.net

# Nextcloud
# Hit the AIO Apache container directly (port 11000) — no TLS needed, avoids Caddy round-trip
NEXTCLOUD_URL=http://localhost:11000

# Disk mount points (margaret — sda/sdb layout)
MOUNT_ROOT=/
MOUNT_NC_DATA=/mnt/nextcloud-data
MOUNT_SIDDH_MAIN=/mnt/siddharth_main
MOUNT_SIDDH_1=/mnt/siddharth_1
MOUNT_VA=/mnt/sda4
